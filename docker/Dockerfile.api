# syntax=docker/dockerfile:1.27
# Product-local last stage for the API (NOT synced). Bake wires context
# `export_bins` → shared base `export-binaries` (see docker-bake.hcl).
#
# Pins: ALPINE_VERSION from versions.env (Bake / --build-arg). No Dockerfile
# default — that would drift from versions.env. ${…:?} requires the arg and
# satisfies BuildKit InvalidDefaultArgInFrom without a stale pin.

ARG ALPINE_VERSION
FROM alpine:${ALPINE_VERSION:?}

ARG RUNTIME_USER=middleware
ARG RUNTIME_UID=65532
ARG RUNTIME_GID=65532

ENV UVICORN_HOST=0.0.0.0
ENV UVICORN_PORT=8000
ENV UVICORN_LOG_LEVEL=info

WORKDIR /api

# Runtime extras required by the API process (curl liveness, git for ArcStore).
# Fleet apk pin style B (Trivy / update via scripts/update-dockerfile-pins.sh).
ARG CA_CERTIFICATES_VERSION=20260909-r0
ARG CURL_VERSION=8.22.0-r0
ARG GIT_VERSION=2.54.0-r0
ARG ZLIB_VERSION=1.3.2-r0
ARG TZDATA_VERSION=2026d-r0
ARG MUSL_UTILS_VERSION=1.2.6-r2
ARG LIBSSL3_VERSION=3.5.8-r0
RUN apk add --no-cache --upgrade \
        "ca-certificates=${CA_CERTIFICATES_VERSION}" \
        "curl=${CURL_VERSION}" \
        "git=${GIT_VERSION}" \
        "zlib=${ZLIB_VERSION}" \
        "tzdata=${TZDATA_VERSION}" \
        "musl-utils=${MUSL_UTILS_VERSION}" \
        "libssl3=${LIBSSL3_VERSION}" \
    && addgroup -S -g "${RUNTIME_GID}" "${RUNTIME_USER}" \
    && adduser -S -u "${RUNTIME_UID}" -H -G "${RUNTIME_USER}" "${RUNTIME_USER}" \
    && chown "${RUNTIME_USER}:${RUNTIME_USER}" /api \
    && git config --system http.postBuffer 524288000 \
    && git config --system http.version HTTP/1.1 \
    && git config --system http.keepAlive false

# Primary onedir from shared product-app.base export-binaries
# (BINARY_NAME=middleware-api is set on Bake target api-base, not here.)
# hadolint ignore=DL3022
COPY --chown=${RUNTIME_USER}:${RUNTIME_USER} --from=export_bins /dist/middleware-api /api/middleware-api

USER ${RUNTIME_USER}

EXPOSE ${UVICORN_PORT}

ENTRYPOINT ["/api/middleware-api/middleware-api"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["sh", "-c", "curl -f http://127.0.0.1:${UVICORN_PORT}/v1/liveness"]
