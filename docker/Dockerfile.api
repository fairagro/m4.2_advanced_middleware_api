# syntax=docker/dockerfile:1.4
# Product-local last stage for the API (NOT synced). Bake wires context
# `export_bins` → shared base `export-binaries` (see docker-bake.hcl).
#
# Pins: ALPINE_VERSION from versions.env (no literal pin here).

ARG ALPINE_VERSION
FROM alpine:${ALPINE_VERSION}

ARG BINARY_NAME=middleware-api
ARG RUNTIME_USER=middleware
ARG RUNTIME_UID=65532
ARG RUNTIME_GID=65532

ENV UVICORN_HOST=0.0.0.0
ENV UVICORN_PORT=8000
ENV UVICORN_LOG_LEVEL=info

WORKDIR /api

# Runtime extras required by the API process (curl liveness, git for ArcStore).
# Keep apk packages version-pinned (Trivy / update via scripts/update-apk-dependencies.sh).
RUN apk add --no-cache --upgrade \
        ca-certificates=20260611-r0 \
        curl=8.22.0-r0 \
        git=2.54.0-r0 \
        zlib=1.3.2-r0 \
        tzdata=2026c-r0 \
        musl-utils=1.2.6-r2 \
        libssl3=3.5.8-r0 \
    && addgroup -S -g "${RUNTIME_GID}" "${RUNTIME_USER}" \
    && adduser -S -u "${RUNTIME_UID}" -H -G "${RUNTIME_USER}" "${RUNTIME_USER}" \
    && chown "${RUNTIME_USER}:${RUNTIME_USER}" /api \
    && git config --system http.postBuffer 524288000 \
    && git config --system http.version HTTP/1.1 \
    && git config --system http.keepAlive false

# Primary onedir from shared product-app.base export-binaries
# hadolint ignore=DL3022
COPY --chown=${RUNTIME_USER}:${RUNTIME_USER} --from=export_bins /dist/${BINARY_NAME} /api/${BINARY_NAME}

USER ${RUNTIME_USER}

EXPOSE ${UVICORN_PORT}

# Exec form: binary is PID 1 (signals). Path matches BINARY_NAME default / Bake override
# used in COPY above; keep in sync with docker-bake.hcl `BINARY_NAME`.
ENTRYPOINT ["/api/middleware-api/middleware-api"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["sh", "-c", "curl -f http://127.0.0.1:${UVICORN_PORT}/v1/liveness"]
