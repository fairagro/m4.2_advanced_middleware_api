{
  // Shared Cursor / VS Code workspace settings for m4.2 Devinfra (and a sync template for products).
  // Interpreter + tool binaries must match `uv sync` / pre-commit / CI (root `.venv`, root `pyproject.toml`).
  // Do not invent product paths here after sync. Pyright/basedpyright SoT: synced pyrightconfig.json
  // (venv, optional stubPath, scripts/ai, typeCheckingMode off — mypy owns type gates; see docs/quality.md).
  // Test roots: each repo pyproject.toml testpaths — keep python.testing.pytestArgs empty so discovery
  // is not overridden.

  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python-envs.defaultEnvManager": "ms-python.python:venv",

  // Workspace member `scripts/ai` is editable via uv; extraPaths keeps analysis working before/without
  // a selected interpreter that already sees the install.
  "python.analysis.extraPaths": ["${workspaceFolder}/scripts/ai/src"],
  "python.analysis.exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
    "**/.venv",
    "**/venv",
    "**/dist"
  ],

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.pytestPath": "${workspaceFolder}/.venv/bin/pytest",
  "python.testing.pytestArgs": [],

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },

  // Same binary + root ruff.toml as `uv run ruff --config ruff.toml` / pre-commit.
  "ruff.enable": true,
  "ruff.nativeServer": "on",
  "ruff.path": ["${workspaceFolder}/.venv/bin/ruff"],
  "ruff.interpreter": ["${workspaceFolder}/.venv/bin/python"],
  "ruff.configuration": "${workspaceFolder}/ruff.toml",
  "ruff.configurationPreference": "editorOnly",
  "ruff.importStrategy": "fromEnvironment",
  "ruff.lint.enable": true,

  // Same fragments + .venv as hooks/CI (`mypy.ini` / `.pylintrc`). Path overlays stay on
  // process env / CI (`MYPYPATH`, `pylint_source_roots`) — not product paths here.
  "mypy-type-checker.importStrategy": "fromEnvironment",
  "mypy-type-checker.interpreter": ["${workspaceFolder}/.venv/bin/python"],
  "mypy-type-checker.cwd": "${workspaceFolder}",
  "mypy-type-checker.args": ["--config-file", "${workspaceFolder}/mypy.ini"],
  "pylint.importStrategy": "fromEnvironment",
  "pylint.interpreter": ["${workspaceFolder}/.venv/bin/python"],
  "pylint.cwd": "${workspaceFolder}",
  "pylint.args": ["--rcfile", "${workspaceFolder}/.pylintrc"],

  "editor.formatOnSave": true,
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[mdc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // Helm Go templates (language mode from Kubernetes Tools). Avoid Red Hat YAML
  // false positives on {{ … }} in chart templates.
  "files.associations": {
    "**/helmchart/**/templates/**/*.yaml": "helm",
    "**/helmchart/**/templates/**/*.yml": "helm",
    "**/helmchart/**/templates/**/*.tpl": "helm",
    "**/helm/**/templates/**/*.yaml": "helm",
    "**/helm/**/templates/**/*.yml": "helm",
    "**/helm/**/templates/**/*.tpl": "helm"
  },
  // Dev Containers often have no cluster kubeconfig; suppress toast noise only.
  // Do not suppress kubectl-not-found — kubectl/helm are on the shared image PATH.
  "vs-kubernetes": {
    "vs-kubernetes.suppress-kubeconfig-not-found-alerts": true
  },

  "cursorpyright.analysis.exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
    "**/.venv",
    "**/venv",
    "**/dist"
  ],
  "cursorpyright.analysis.extraPaths": [
    "${workspaceFolder}/scripts/ai/src"
  ]
}
