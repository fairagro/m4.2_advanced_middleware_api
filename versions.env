# Source of truth for toolchain versions (repo-wide).
# Consumed via: source versions.env / Docker Compose (.devcontainer/.env symlink).
#
# Exact pins live here only (one pin per software component). Dev Container tools and
# product-app image build pins share this file in separate sections. Do not restate
# these values as Dockerfile ARG defaults or Bake HCL variable defaults — inject via
# build-arg / Bake --set from this file (see docs/ci.md).
#
# Exception: distro packages like jq / gnupg / JRE / graphviz stay unpinned here.

# ── Dev Container base ────────────────────────────────────────────────────────
DEVCONTAINER_BASE_IMAGE=mcr.microsoft.com/devcontainers/base:2.1.15-trixie

# ── Python / uv (Dev Container + product-app image builders) ───────────────────
PYTHON_VERSION=3.12.14
UV_VERSION=0.12.9

# ── Product app image (Docker Bake / reusable-build / CST) ────────────────────
# Alpine patch tag for last-stage FROM; ALPINE_MINOR is the python:-alpineN.M tag.
PIP_VERSION=26.2.1
ALPINE_VERSION=3.24.1
ALPINE_MINOR=3.24
PYINSTALLER_VERSION=6.16.0

# ── Kubernetes / cluster tools ────────────────────────────────────────────────
KUBECTL_VERSION=v1.36.1
HELM_VERSION=v4.2.0
MINIKUBE_VERSION=v1.37.0

# ── Secrets (encrypted-in-repo; ciphertext stays product-local) ───────────────
SOPS_VERSION=v3.10.2
AGE_VERSION=v1.3.1

# ── Query / format / lint CLIs ────────────────────────────────────────────────
YQ_VERSION=v4.48.1
XQ_VERSION=v1.5.1
YAMLFMT_VERSION=v0.14.0
HADOLINT_VERSION=v2.12.0
STARSHIP_VERSION=v1.25.1

# ── Container / security / deps ───────────────────────────────────────────────
CST_VERSION=v1.19.1
TRIVY_VERSION=v0.74.0
RENOVATE_VERSION=44.65.5

# ── Node + shared npm globals ─────────────────────────────────────────────────
NODE_VERSION=v22.23.2
OPENSPEC_VERSION=1.7.0
PRETTIER_VERSION=3.9.6
MARKDOWNLINT_CLI2_VERSION=0.23.2
