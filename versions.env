# Source of truth for toolchain versions (repo-wide).
# Consumed via: source versions.env / Docker Compose (.devcontainer/.env symlink).
#
# Exact pins live here only (one pin per software component). Dev Container tools and
# product-app image build pins share this file in separate sections. Do not restate
# these values as Dockerfile ARG defaults or Bake HCL variable defaults — inject via
# build-arg / Bake --set from this file (see docs/ci.md).
#
# Exception: distro packages like jq / gnupg / JRE / graphviz stay unpinned here.

# ── Dev Container base ────────────────────────────────────────────────────────
DEVCONTAINER_BASE_IMAGE=mcr.microsoft.com/devcontainers/base:2.2.5-trixie

# ── Python / uv (Dev Container + product-app image builders) ───────────────────
PYTHON_VERSION=3.12.16
UV_VERSION=0.13.7

# ── Product app image (Docker Bake / reusable-build / CST) ────────────────────
# Alpine patch tag for last-stage FROM; ALPINE_MINOR is the python:-alpineN.M tag.
PIP_VERSION=26.3
ALPINE_VERSION=3.24.3
ALPINE_MINOR=3.24
PYINSTALLER_VERSION=6.22.3

# ── Kubernetes / cluster tools ────────────────────────────────────────────────
KUBECTL_VERSION=v1.37.2
HELM_VERSION=v4.3.1
MINIKUBE_VERSION=v1.39.0

# ── Secrets (encrypted-in-repo; ciphertext stays product-local) ───────────────
SOPS_VERSION=v3.13.3
AGE_VERSION=v1.3.2

# ── Query / format / lint CLIs ────────────────────────────────────────────────
YQ_VERSION=v4.54.1
XQ_VERSION=v1.5.1
YAMLFMT_VERSION=v0.21.0
HADOLINT_VERSION=v2.15.1
STARSHIP_VERSION=v1.27.0

# ── Container / security / deps ───────────────────────────────────────────────
CST_VERSION=v1.22.1
GITLEAKS_VERSION=v8.30.1
TRIVY_VERSION=v0.76.2
RENOVATE_VERSION=44.219.0
# git-cliff: Conventional Commits → release version_bump=auto (scripts/detect-version-bump.sh)
GIT_CLIFF_VERSION=v2.14.2

# ── Node + shared npm globals ─────────────────────────────────────────────────
NODE_VERSION=v24.22.2
# npm CLI (pinned separately from Node; initial = bundled with NODE_VERSION above)
NPM_VERSION=12.2.2
OPENSPEC_VERSION=1.16.0
PRETTIER_VERSION=3.9.10
MARKDOWNLINT_CLI2_VERSION=0.24.0
