# Source of truth for toolchain and runtime versions (repo-wide).
# Consumed via: source versions.env / Docker Compose env_file / .devcontainer/.env symlink.
#
# .python-version is kept in sync with PYTHON_VERSION for uv / setup-python
# (see scripts/load-versions-env.sh).

# ── Runtime (API image + workers) ─────────────────────────────────────────────
PYTHON_VERSION=3.12.14
ALPINE_VERSION=3.24.1
PIP_VERSION=26.2.1
UV_VERSION=0.12.9

# ── Dev Container toolchain ───────────────────────────────────────────────────
DEVCONTAINER_BASE_IMAGE=mcr.microsoft.com/devcontainers/base:2.1.15-trixie
KUBECTL_VERSION=v1.36.1
HELM_VERSION=v4.2.0
SOPS_VERSION=v3.10.2
AGE_VERSION=v1.3.1
STARSHIP_VERSION=v1.25.1
DIFFTASTIC_VERSION=0.69.0
PRECOMMIT_VERSION=4.6.0
YQ_VERSION=v4.48.1
YAMLFMT_VERSION=v0.14.0
HADOLINT_VERSION=v2.12.0
CST_VERSION=v1.19.1
MINIKUBE_VERSION=v1.37.0
NODE_VERSION=v20.20.2
OPENSPEC_VERSION=1.7.0
