# Product-owned Dev Container env overlay (not synced). See docs/devcontainer.md.
# Mirrors former scripts/load-env.sh defaults for hooks/CI path overlays and Wave C CST.
#
# MYPYPATH / PYLINT_SOURCE_ROOTS are re-read from this file by scripts/run-quality-cli.sh
# on every quality invoke (hooks/CI). CST_* still come from Compose env_file at create.

MYPYPATH=middleware/api/src:middleware/api_client/src:middleware/api_local_offline/src:middleware/arc_validation/src:middleware/shared/src:middleware/api/tests/unit:middleware/api_client/tests/unit:middleware/api_local_offline/tests/unit:middleware/arc_validation/tests/unit:middleware/shared/tests
CST_BAKE_TARGET=api
