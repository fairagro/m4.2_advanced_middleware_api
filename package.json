{
  "name": "m4.2_middleware_devinfra",
  "private": true,
  "description": "Shared Devinfra tooling pins and scripts for FAIRagro m4.2 middleware repos",
  "scripts": {
    "format:md": "prettier --write \"**/*.{md,mdc}\"",
    "format:md:check": "prettier --check \"**/*.{md,mdc}\"",
    "format:md:skills": "prettier --write --ignore-path /dev/null \".agents/skills/{review-fixer,create-issue,code-review,issue-fixer,arctrl}/**/*.{md,mdc}\"",
    "lint:md": "markdownlint-cli2",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=24"
  }
}
