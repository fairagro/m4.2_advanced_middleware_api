# Fleet import-linter baseline (synced). Product layers/forbidden → `.importlinter` (overlay).
# See docs/quality.md and openspec/principles.global.md Import policy.

[importlinter]
root_package = middleware
exclude_type_checking_imports = True

[importlinter:contract:middleware-acyclic-siblings]
name = middleware sibling packages must be acyclic
type = acyclic_siblings
ancestors =
    middleware
