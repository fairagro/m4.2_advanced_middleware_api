{
  "@context": {
    "@vocab": "https://schema.org/",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "fairagro": "https://fairagro.github.io/m4.2_advanced_middleware_api/ns/harvest-report/v1/#",
    "harvestDurationSeconds": {
      "@id": "fairagro:harvestDurationSeconds",
      "@type": "xsd:double"
    },
    "harvestId": {
      "@id": "fairagro:harvestId",
      "@type": "xsd:string"
    },
    "expectedDatasets": {
      "@id": "fairagro:expectedDatasets",
      "@type": "xsd:integer"
    },
    "harvestedDatasets": {
      "@id": "fairagro:harvestedDatasets",
      "@type": "xsd:integer"
    },
    "failedDatasets": {
      "@id": "fairagro:failedDatasets",
      "@type": "xsd:integer"
    },
    "skippedDatasets": {
      "@id": "fairagro:skippedDatasets",
      "@type": "xsd:integer"
    },
    "failedRecords": {
      "@id": "fairagro:failedRecords",
      "@container": "@list"
    },
    "message": {
      "@id": "fairagro:message",
      "@type": "xsd:string"
    },
    "recordId": {
      "@id": "fairagro:recordId",
      "@type": "xsd:string"
    },
    "url": {
      "@id": "fairagro:url",
      "@type": "@id"
    },
    "totalStudies": {
      "@id": "fairagro:totalStudies",
      "@type": "xsd:integer"
    },
    "totalAssays": {
      "@id": "fairagro:totalAssays",
      "@type": "xsd:integer"
    }
  }
}
