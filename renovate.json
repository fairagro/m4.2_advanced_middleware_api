{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": ["config:recommended"],

  "timezone": "Europe/Berlin",

  "gitAuthor": "Carsten Scharfenberg <138563220+Zalfsten@users.noreply.github.com>",

  "enabledManagers": [
    "dockerfile",
    "devcontainer",
    "pep621",
    "npm",
    "github-actions",
    "custom.regex"
  ],

  "rangeStrategy": "auto",

  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,

  "labels": ["dependencies"],

  "rebaseWhen": "behind-base-branch",

  "commitMessagePrefix": "deps:",

  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am on monday"],
    "recreateWhen": "auto"
  },

  "devcontainer": {
    "managerFilePatterns": ["/(^|/)\\.devcontainer(/.+)?/devcontainer\\.json$/"]
  },

  "customManagers": [
    {
      "description": "Python patch pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["PYTHON_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "python",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "loose"
    },
    {
      "description": "Python patch pin in .python-version (mirror of versions.env)",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.python-version$/"],
      "matchStrings": ["^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "python",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "loose"
    },
    {
      "description": "Alpine patch pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["ALPINE_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "alpine",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "loose"
    },
    {
      "description": "Dev Container base image pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": [
        "DEVCONTAINER_BASE_IMAGE=(?<depName>[^:\\s#]+):(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "uv pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["UV_VERSION=(?<currentValue>[^\\s#]+)"],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "uv",
      "versioningTemplate": "pep440"
    },
    {
      "description": "pip pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["PIP_VERSION=(?<currentValue>[^\\s#]+)"],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "pip",
      "versioningTemplate": "pep440"
    },
    {
      "description": "PyInstaller pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["PYINSTALLER_VERSION=(?<currentValue>[^\\s#]+)"],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "pyinstaller",
      "versioningTemplate": "pep440"
    },
    {
      "description": "Trivy pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["TRIVY_VERSION=(?<currentValue>v?[^\\s#]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "aquasecurity/trivy",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "TRIVY_VERSION=v{{newVersion}}"
    },
    {
      "description": "Renovate CLI pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["RENOVATE_VERSION=(?<currentValue>[^\\s#]+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "renovate",
      "versioningTemplate": "npm"
    },
    {
      "description": "OpenSpec CLI pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["OPENSPEC_VERSION=(?<currentValue>[^\\s#]+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@fission-ai/openspec",
      "versioningTemplate": "npm"
    },
    {
      "description": "Prettier pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["PRETTIER_VERSION=(?<currentValue>[^\\s#]+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "prettier",
      "versioningTemplate": "npm"
    },
    {
      "description": "markdownlint-cli2 pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["MARKDOWNLINT_CLI2_VERSION=(?<currentValue>[^\\s#]+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "markdownlint-cli2",
      "versioningTemplate": "npm"
    },
    {
      "description": "Node pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["NODE_VERSION=(?<currentValue>v?[^\\s#]+)"],
      "datasourceTemplate": "node-version",
      "depNameTemplate": "node",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "NODE_VERSION=v{{newVersion}}"
    },
    {
      "description": "npm CLI pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["NPM_VERSION=(?<currentValue>[^\\s#]+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "description": "kubectl pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["KUBECTL_VERSION=(?<currentValue>v?[^\\s#]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes/kubernetes",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "KUBECTL_VERSION=v{{newVersion}}"
    },
    {
      "description": "Helm pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["HELM_VERSION=(?<currentValue>v?[^\\s#]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "helm/helm",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "HELM_VERSION=v{{newVersion}}"
    },
    {
      "description": "Minikube pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["MINIKUBE_VERSION=(?<currentValue>v?[^\\s#]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes/minikube",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "MINIKUBE_VERSION=v{{newVersion}}"
    },
    {
      "description": "SOPS pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["SOPS_VERSION=(?<currentValue>v?[^\\s#]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "getsops/sops",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "SOPS_VERSION=v{{newVersion}}"
    },
    {
      "description": "age pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["AGE_VERSION=(?<currentValue>v?[^\\s#]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "FiloSottile/age",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "AGE_VERSION=v{{newVersion}}"
    },
    {
      "description": "yq pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["YQ_VERSION=(?<currentValue>v?[^\\s#]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "mikefarah/yq",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "YQ_VERSION=v{{newVersion}}"
    },
    {
      "description": "xq pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["XQ_VERSION=(?<currentValue>v?[^\\s#]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "sibprogrammer/xq",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "XQ_VERSION=v{{newVersion}}"
    },
    {
      "description": "yamlfmt pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["YAMLFMT_VERSION=(?<currentValue>v?[^\\s#]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "google/yamlfmt",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "YAMLFMT_VERSION=v{{newVersion}}"
    },
    {
      "description": "hadolint pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["HADOLINT_VERSION=(?<currentValue>v?[^\\s#]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "hadolint/hadolint",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "HADOLINT_VERSION=v{{newVersion}}"
    },
    {
      "description": "Starship pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["STARSHIP_VERSION=(?<currentValue>v?[^\\s#]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "starship/starship",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "STARSHIP_VERSION=v{{newVersion}}"
    },
    {
      "description": "container-structure-test pin in versions.env",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["CST_VERSION=(?<currentValue>v?[^\\s#]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "GoogleContainerTools/container-structure-test",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "autoReplaceStringTemplate": "CST_VERSION=v{{newVersion}}"
    }
  ],

  "packageRules": [
    {
      "description": "Product repos: do not bump Devinfra-synced SoT files (land in Devinfra, then sync #13)",
      "matchRepositories": [
        "fairagro/m4.2_advanced_middleware_api",
        "fairagro/m4.2_sql_to_arc",
        "fairagro/m4.2_middleware_harvester"
      ],
      "matchFileNames": [
        "versions.env",
        ".python-version",
        "docker/Dockerfile.product-app.base",
        ".devcontainer/Dockerfile",
        "renovate.json",
        ".github/workflows/renovate.yml",
        ".github/workflows/codeql.yml"
      ],
      "enabled": false
    },
    {
      "description": "Product repos: BuildKit frontend pin is documented/bumped in Devinfra examples",
      "matchRepositories": [
        "fairagro/m4.2_advanced_middleware_api",
        "fairagro/m4.2_sql_to_arc",
        "fairagro/m4.2_middleware_harvester"
      ],
      "matchPackageNames": ["docker/dockerfile"],
      "enabled": false
    },
    {
      "description": "Python 3.12 global lock (versions.env + .python-version)",
      "matchManagers": [
        "dockerfile",
        "devcontainer",
        "github-actions",
        "custom.regex"
      ],
      "allowedVersions": "/^3\\.12/",
      "groupName": "Python 3.12 runtime",
      "matchPackageNames": ["/python/"]
    },
    {
      "description": "Runtime Sync: Docker + Devcontainer base images",
      "matchManagers": ["dockerfile", "devcontainer", "custom.regex"],
      "groupName": "Runtime base (Docker + Devcontainer)",
      "matchPackageNames": [
        "/^alpine$/",
        "/^mcr\\.microsoft\\.com/devcontainers/"
      ]
    },
    {
      "description": "Devcontainer features",
      "matchManagers": ["devcontainer"],
      "groupName": "Devcontainer features",
      "separateMinorPatch": true,
      "matchPackageNames": ["/ghcr\\.io/.*/features//", "//features//"]
    },
    {
      "description": "Python application dependencies (uv / pep621)",
      "matchManagers": ["pep621"],
      "groupName": "Python dependencies (uv)",
      "rangeStrategy": "widen",
      "separateMinorPatch": true
    },
    {
      "description": "Python build tools (pip/uv/pyinstaller via regex)",
      "matchDatasources": ["pypi"],
      "groupName": "Python build tools"
    },
    {
      "description": "npm toolchain pins (package.json + versions.env)",
      "matchDatasources": ["npm"],
      "groupName": "npm toolchain"
    },
    {
      "description": "GitHub release CLI pins in versions.env",
      "matchDatasources": ["github-releases"],
      "groupName": "GitHub release CLIs",
      "separateMinorPatch": true
    },
    {
      "description": "GitHub Actions updates (stable grouping)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "GitHub Actions major updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "GitHub Actions (major)"
    },
    {
      "description": "Alpine Docker tags: patch-only (images + versions.env regex)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["alpine"],
      "matchUpdateTypes": ["patch"],
      "groupName": "Alpine Docker (patch)"
    },
    {
      "description": "Disable Alpine Docker minor/major bumps",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["alpine"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    }
  ],

  "ignorePaths": [
    "**/node_modules/**",
    "**/__pycache__/**",
    "openspec/changes/**"
  ]
}
