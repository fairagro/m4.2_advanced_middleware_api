#!/usr/bin/env bash
# Short name for docker in the shared m4.2 Dev Container.
# Binary: /usr/bin/docker (Docker-in-Docker feature in .devcontainer/devcontainer.json).
# On PATH via remoteEnv (scripts/bin). No tokens; no bashrc. Completion: image file
# /usr/share/bash-completion/completions/d
set -euo pipefail
exec /usr/bin/docker "$@"
