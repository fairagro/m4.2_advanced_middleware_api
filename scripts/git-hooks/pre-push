#!/usr/bin/env bash
# Pre-push dispatcher: buffer stdin once, run pre-push.d/* in lexicographic order.
# Installed via scripts/setup-git-hooks.sh (Devinfra-owned entrypoint).
#
# Environment: host or Dev Container. Product fragments (e.g. Git LFS) live alongside
# the shared 50-quality fragment under .git/hooks/pre-push.d/.

set -euo pipefail

stdin_file="$(mktemp)"
trap 'rm -f "${stdin_file}"' EXIT
cat >"${stdin_file}"

HERE="$(cd "$(dirname "$0")" && pwd)"
FRAG_DIR="${HERE}/pre-push.d"

if [[ ! -d "${FRAG_DIR}" ]]; then
  echo >&2 "pre-push: missing fragment dir: ${FRAG_DIR}"
  exit 1
fi

shopt -s nullglob
fragments=( "${FRAG_DIR}"/* )
shopt -u nullglob

if [[ ${#fragments[@]} -eq 0 ]]; then
  echo >&2 "pre-push: no fragments in ${FRAG_DIR}"
  exit 1
fi

mapfile -t fragments_sorted < <(printf '%s\n' "${fragments[@]}" | LC_ALL=C sort)

for frag in "${fragments_sorted[@]}"; do
  [[ -f "${frag}" ]] || continue
  if [[ ! -x "${frag}" ]]; then
    echo >&2 "pre-push: fragment not executable: ${frag}"
    exit 1
  fi
  "${frag}" "$@" <"${stdin_file}"
done
