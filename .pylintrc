# Shared Pylint config for m4.2 product repos (sync into product checkout root).
# Aligned with shared ruff.toml (duplicate checks disabled).
#
# Product path overlay: do not edit this synced file (sync overwrites it). Shared hooks/CI
# pass --rcfile .pylintrc, so [tool.pylint.*] in product pyproject.toml is ignored.
# Prefer reusable CI input `pylint_source_roots` (docs/ci.md). Do not patch synced
# .pre-commit-config.yaml to add --source-roots. Example local/CI invocation:
#   uv run pylint --rcfile .pylintrc --source-roots=middleware/api/src,middleware/shared/src middleware/
#
# C extensions: extension-pkg-allow-list=lxml loads lxml so pylint can see
# lxml.etree._Element / fromstring (I1101). Do not silence I1101 with Any aliases.
# Products that already pass --extension-pkg-allow-list=lxml on CLI/hooks may drop
# that flag after syncing this file.
#
# Untyped fleet deps (arctrl / fable_library): ignored-modules — do not reintroduce
# incomplete shared stubs for those packages.

[FORMAT]
max-line-length=120

[MASTER]
ignore=.venv,venv,.git,__pycache__,build,dist
ignore-patterns=^\..*,.*\.egg-info
fail-under=8.0
extension-pkg-allow-list=lxml
# Untyped fleet deps (no shared stubs): suppress import-error / member checks for these packages.
ignored-modules=arctrl,fable_library

[MESSAGES CONTROL]
disable=C0114,C0115,C0116,C0411,C0412,C0413,W0611,W0614,C0303,C0304,C0305,C0321,C0325,W0311,W0301,C0103,R0912,R0915,W0101,W0102,W0107,W0125,W0511,W0612,W0613,W0621,W0622,R1705,R1714,R1715,R1720,R1724,R1728,R1711,C0206,R0903,R0913,R0917,C0301,R0801,R0914,W0718,W0703,W0212
